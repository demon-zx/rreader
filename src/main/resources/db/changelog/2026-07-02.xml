<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="dmitry" id="create-table-processed-file">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="processed_file"/>
            </not>
        </preConditions>
        <createTable tableName="processed_file">
            <column name="id" type="uuid" defaultValue="RANDOM_UUID()">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="processed" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="varchar(16)"/>
            <column name="error" type="varchar(4096)"/>
            <column name="processed_at" type="timestamp"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="updated_by" type="varchar(128)"/>
        </createTable>
        <addPrimaryKey constraintName="pk_processed_file" tableName="processed_file" columnNames="id"/>
        <addUniqueConstraint constraintName="uq_processed_file_path" tableName="processed_file" columnNames="path"/>
    </changeSet>
</databaseChangeLog>
